NODE_ENV=production
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://kasir_user:password@127.0.0.1:5432/kasir
# Set true only when your Postgres provider requires SSL.
DB_SSL=false

# Required in production. Use a long random value.
AUTH_SECRET=change-me-to-a-long-random-secret
SESSION_DAYS=7

# First-run bootstrap (run: npm run bootstrap:admin)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password
BOOTSTRAP_ADMIN_NAME=Admin Kasir
BOOTSTRAP_STORE_NAME=Aplikasi Kasir
# BOOTSTRAP_STORE_ADDRESS=Alamat toko
# BOOTSTRAP_INDUSTRY=fnb
# BOOTSTRAP_TAX_RATE=10
# BOOTSTRAP_SEED_SAMPLE=false
# BOOTSTRAP_RESET_PASSWORD=false

# Optional when the frontend and API are served from different domains.
# CORS_ORIGIN=https://kasir.example.com

# Optional. Default false: user dibuat oleh admin dari menu Users.
# ALLOW_PUBLIC_SIGNUP=false

# Optional digital receipt email.
# GMAIL_SMTP_USER=nama@gmail.com
# GMAIL_SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
# GMAIL_SMTP_FROM=nama@gmail.com
# GMAIL_SMTP_FROM_NAME=Aplikasi Kasir

# Optional WhatsApp via Fonnte.
# FONNTE_TOKEN=token_fonnte
# FONNTE_DEFAULT_COUNTRY_CODE=62

# Akun pembeli toko online (/toko/masuk).
# Isi dengan OAuth Client ID dari Google Cloud Console (tipe Web application,
# Authorized JavaScript origin = domain toko). Kosong = tombol Google memberi tahu belum aktif.
# GOOGLE_CLIENT_ID=
# Batas percobaan daftar/masuk pembeli per IP per 10 menit (bawaan 20).
# CUSTOMER_AUTH_RATE_MAX=

# Email kode "Lupa kata sandi" pembeli. Tanpa SMTP_HOST: di lokal email disimpan ke
# server/.outbox (tidak terkirim), di produksi fitur ini menolak dengan pesan jelas.
# SMTP_HOST=smtp.contoh.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="GNNK Racing <no-reply@gnnkracing.id>"

# --- Tripay (payment gateway) ---------------------------------------------
# Diambil dari dashboard.tripay.co.id > API & Integrasi (sandbox) atau
# Merchant > Opsi > Edit (production). Selama kosong, checkout hanya memakai
# metode manual: COD, transfer bank, dan QRIS statis.
TRIPAY_MODE=sandbox
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
# Alamat callback yang didaftarkan di dashboard Tripay:
TRIPAY_CALLBACK_URL=https://kasir-danang.vercel.app/api/tripay/callback
TRIPAY_RETURN_URL=https://kasir-danang.vercel.app/toko/akun?tab=pesanan

# --- KiriminAja (ongkir & kirim paket) -------------------------------------
# Token dari app.kiriminaja.com. Selama kosong, ongkir tetap diisi staff saat
# mengonfirmasi pesanan.
KIRIMINAJA_MODE=sandbox
KIRIMINAJA_TOKEN=
# Id kecamatan & kelurahan gudang toko (asal pengiriman):
KIRIMINAJA_ORIGIN_DISTRICT=
KIRIMINAJA_ORIGIN_SUBDISTRICT=

# --- Mailketing (email transaksional) --------------------------------------
# Token dari be.mailketing.co.id > API Integration. Dipakai mengirim kode
# reset kata sandi pembeli; bila kosong, pengiriman memakai SMTP_* di atas.
MAILKETING_API_TOKEN=
MAILKETING_FROM_EMAIL=
MAILKETING_FROM_NAME=GNNK Racing
